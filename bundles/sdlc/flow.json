      "label": "Groom",
      "step": "Groom",
      "kind": "model",
      "exits": [
        {
          "name": "file",
          "to": "file-tickets",
          "statuses": [
            "pass"
          ]
        },
        {
          "name": "fix",
          "to": "groom",
          "statuses": [
            "fail"
          ]
        }
      ],
      "persona": "groom-reviewer",
      "scope": "chunk"
    },
    {
      "id": "file-tickets",
      "label": "Groom",
      "step": "Groom",
      "kind": "model",
      "exits": [
        {
          "name": "items",
          "to": "@items",
          "statuses": [
            "pass"
          ]
        }
      ],
      "persona": "manager",
      "outputs": [
        "{design}/groom.md"
      ],
      "scope": "chunk"
    },
    {
      "id": "build",
      "label": "Build",
      "step": "Build",
      "kind": "model",
      "exits": [
        {
          "name": "prove",
          "statuses": [
            "pass",
            "fail"
          ],
          "to": "prove"
        }
      ],
      "persona": "builder",
      "scope": "item"
    },
    {
      "id": "prove",
      "label": "Build",
      "step": "Build",
      "kind": "command",
      "exits": [
        {
          "name": "verify",
          "to": "verify",
          "statuses": [
            "pass"
          ]
        },
        {
          "name": "fix",
          "to": "build",
          "statuses": [
            "fail"
          ]
        }
      ],
      "scope": "item",
      "commands": "groom"
    },
    {
      "id": "verify",
      "label": "Verify",
      "step": "Build",
      "kind": "model",
      "exits": [
        {
          "name": "review",
          "to": "review",
          "statuses": [
            "pass"
          ]
        },
        {
          "name": "fix",
          "to": "build",
          "statuses": [
            "fail"
          ]
        }
      ],
      "persona": "verifier",
      "checks": [
        "dod"
      ],
      "scope": "item"
    },
    {
      "id": "review",
      "label": "Review",
      "step": "Review",
      "kind": "model",
      "exits": [
        {
          "name": "land",
          "to": "land",
          "statuses": [
            "pass"
          ]
        },
        {
          "name": "fix",
          "to": "build",
          "statuses": [
            "fail"
          ]
        }
      ],
      "persona": "reviewer",
      "checks": [
        "intake",
        "sha-pins",
        "trust-boundary",
        "env-harness"
      ],
      "scope": "item"
    },
    {
      "id": "land",
      "label": "Land",
      "step": "Build",
      "kind": "land",
      "exits": [
        {
          "name": "done",
          "to": "@done",
          "statuses": [
            "pass"
          ]
        }
      ],
      "builder": "build",
      "prove": "prove",
      "verify": "verify",
      "review": "review",
      "scope": "item"
    }
  ]
}
