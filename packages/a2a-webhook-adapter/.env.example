# Copy to ~/.config/a2a-webhook-adapter/adapter.env and chmod 600.
# Never commit a filled copy. Placeholder values only.

WEBHOOK_URL=https://api2.cursor.sh/automations/webhook/YOUR_ROUTINE_ID
WEBHOOK_KEY=crsr_replace_me

# Optional. If omitted, the A2A Bearer token is WEBHOOK_KEY (one secret).
# A commented line does not count as an assignment:
# A2A_PEER_TOKEN=

BIND_HOST=127.0.0.1
BIND_PORT=8780
